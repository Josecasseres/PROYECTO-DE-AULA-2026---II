@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundCorner 14
skinparam ArrowColor #5E35B1
skinparam ArrowFontColor #4527A0
skinparam TitleFontSize 17
skinparam TitleFontColor #4527A0
skinparam ActivityBackgroundColor #EDE7F6
skinparam ActivityBorderColor #7E57C2
skinparam ActivityDiamondBackgroundColor #FFF3C4
skinparam ActivityDiamondBorderColor #C9A227
skinparam ActivityStartColor #5E35B1
skinparam ActivityEndColor #5E35B1
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam SwimlaneBorderColor #B39DDB
skinparam SwimlaneTitleFontColor #4527A0
skinparam SwimlaneTitleFontStyle bold
title Diagrama de actividad – Agregar libro (CU-09)

|Administrador|
start
:Entra a "Agregar libro";
:Llena ISBN, título, categoría, cantidad,\nnombre y correo del autor;
note right: La categoría se puede elegir\ndel desplegable
:Pulsa "Agregar";
|Sistema|
if (¿Algún campo está vacío?) then (sí)
  :Muestra "Los campos no pueden estar vacíos";
elseif (¿La cantidad no es un entero mayor que 0?) then (sí)
  :Muestra "Por favor, ingrese una cantidad válida";
else (no)
  |Base de datos|
  :Inserta el libro y su autor\n(tablas libro y autor);
  |Sistema|
  if (¿Se guardaron los datos?) then (sí)
    :Muestra "Los datos del libro se agregaron\ncorrectamente" y limpia los campos;
  else (no)
    :Muestra un mensaje de error;
  endif
endif
stop
@enduml
