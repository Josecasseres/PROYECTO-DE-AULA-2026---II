@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundCorner 14
skinparam ArrowColor #5E35B1
skinparam ArrowFontColor #4527A0
skinparam TitleFontSize 17
skinparam TitleFontColor #4527A0
skinparam ActivityBackgroundColor #EDE7F6
skinparam ActivityBorderColor #7E57C2
skinparam ActivityDiamondBackgroundColor #FFF3C4
skinparam ActivityDiamondBorderColor #C9A227
skinparam ActivityStartColor #5E35B1
skinparam ActivityEndColor #5E35B1
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam SwimlaneBorderColor #B39DDB
skinparam SwimlaneTitleFontColor #4527A0
skinparam SwimlaneTitleFontStyle bold
title Diagrama de actividad – Eliminar libro (CU-11)

|Administrador|
start
:Entra a "Lista todos los libros";
:Selecciona un libro de la tabla\ny pulsa "Eliminar";
|Sistema|
if (¿Hay un libro seleccionado?) then (no)
  :Muestra "Por favor, seleccione\nun libro de la tabla";
else (sí)
  |Base de datos|
  :Cuenta los préstamos del libro;
  |Sistema|
  if (¿El libro tiene préstamos\nregistrados?) then (sí)
    :Muestra "No se puede eliminar:\nel libro tiene préstamos registrados";
  else (no)
    :Pide confirmación\n"¿Seguro que desea eliminar el libro?";
    if (¿Confirma?) then (sí)
      |Base de datos|
      :Borra primero el autor\ny luego el libro;
      |Sistema|
      :Muestra "Libro eliminado correctamente"\ny recarga la tabla;
    else (no)
      :No se elimina nada;
    endif
  endif
endif
stop
@enduml
