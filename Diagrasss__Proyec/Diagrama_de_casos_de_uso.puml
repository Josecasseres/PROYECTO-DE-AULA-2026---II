@startuml
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundCorner 14
skinparam ArrowColor #5E35B1
skinparam ArrowFontColor #4527A0
skinparam TitleFontSize 17
skinparam TitleFontColor #4527A0
skinparam ActivityBackgroundColor #EDE7F6
skinparam ActivityBorderColor #7E57C2
skinparam ActivityDiamondBackgroundColor #FFF3C4
skinparam ActivityDiamondBorderColor #C9A227
skinparam ActivityStartColor #5E35B1
skinparam ActivityEndColor #5E35B1
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam SwimlaneBorderColor #B39DDB
skinparam SwimlaneTitleFontColor #4527A0
skinparam SwimlaneTitleFontStyle bold
skinparam usecaseBackgroundColor #EDE7F6
skinparam usecaseBorderColor #7E57C2
skinparam actorBorderColor #4527A0
skinparam actorBackgroundColor #EDE7F6
skinparam classBackgroundColor #EDE7F6
skinparam classBorderColor #7E57C2
skinparam packageBorderColor #B39DDB
skinparam rectangleBackgroundColor #F6F2FC
skinparam rectangleBorderColor #7E57C2
skinparam componentBackgroundColor #EDE7F6
skinparam componentBorderColor #7E57C2
skinparam databaseBackgroundColor #FFF3C4
skinparam databaseBorderColor #C9A227
skinparam ArrowFontSize 11
title Diagrama de casos de uso – Sistema de gestión de biblioteca
left to right direction
actor "Bibliotecario /\nAdministrador" as A
actor "Estudiante" as E
actor "Base de datos\nMySQL" as BD <<sistema>>
rectangle "Biblioteca SIT" {
  usecase "CU-01 Iniciar sesión" as U1
  usecase "CU-09 Agregar libro" as U2
  usecase "CU-02 Buscar libro" as U3
  usecase "CU-12 Listar libros" as U4
  usecase "CU-10 Editar libro" as U5
  usecase "CU-11 Eliminar libro" as U6
  usecase "CU-05 Prestar libro" as U7
  usecase "CU-03 Buscar estudiante" as U8
  usecase "CU-04 Registrar estudiante" as U10
  usecase "CU-06 Deshacer último préstamo" as U11
  usecase "CU-13 Listar libros prestados" as U12
  usecase "CU-08 Devolver libro" as U13
  usecase "CU-14 Ver libros por devolver hoy" as U14
    usecase "CU-07 Atender cola de espera" as U16
  usecase "CU-15 Cerrar sesión" as U17
}
A -- U1
E ..> A : solicita / devuelve\nel libro
A -- U2
A -- U3
A -- U4
A -- U5
A -- U6
A -- U7
A -- U11
A -- U13
A -- U14
A -- U16
A -- U17
U7 ..> U3 : <<include>>
U7 ..> U8 : <<include>>
U10 .u.> U8 : <<extend>>
U11 .u.> U7 : <<extend>>
U5 ..> U3 : <<include>>
U6 ..> U3 : <<include>>
U13 ..> U12 : <<include>>
U1 -- BD
U7 -- BD
U13 -- BD
U2 -- BD
note bottom of BD : Asiste a todos los casos de uso\n(guarda y consulta los datos)
note right of U1
  Todos los casos de uso, salvo
  "Iniciar sesión", requieren
  una sesión iniciada.
end note
@enduml
