@startuml
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #5E35B1
skinparam roundCorner 14
skinparam ActivityBackgroundColor #EDE7F6
skinparam ActivityBorderColor #7E57C2
skinparam ActivityDiamondBackgroundColor #FFF3C4
skinparam ActivityDiamondBorderColor #C9A227
skinparam ActivityStartColor #5E35B1
skinparam ActivityEndColor #5E35B1
skinparam SequenceLifeLineBorderColor #7E57C2
skinparam ParticipantBackgroundColor #EDE7F6
skinparam ParticipantBorderColor #7E57C2
skinparam ActorBackgroundColor #EDE7F6
skinparam DatabaseBackgroundColor #FFF3C4
skinparam StateBackgroundColor #EDE7F6
skinparam StateBorderColor #7E57C2
skinparam ComponentBackgroundColor #EDE7F6
skinparam ComponentBorderColor #7E57C2
skinparam NodeBackgroundColor #F6F2FC
skinparam NodeBorderColor #7E57C2
skinparam ClassBackgroundColor #EDE7F6
skinparam ClassBorderColor #7E57C2
title Diagrama de componentes – Arquitectura en capas
package "Interfaz (Swing)" {
  [VentanaInicioSesion]
  [VentanaPrincipal]
  [VentanaColaEspera]
  [DialogoAgregarEstudiante]
  [PanelFondo / Iconos]
}
package "Estructuras de datos" {
  [Cola<T>]
  [Pila<T>]
  [Nodo<T>]
}
package "Acceso a datos (DAO)" {
  [LibroDAO]
  [AdministradorDAO]
  [GestorConexionBD]
}
package "Modelo" {
  [Libro]
  [Autor]
  [Estudiante]
  [Prestamo]
  [Administrador]
}
database "MySQL\nbd_biblioteca" as DB
[VentanaInicioSesion] --> [AdministradorDAO]
[VentanaInicioSesion] --> [VentanaPrincipal]
[VentanaPrincipal] --> [LibroDAO]
[VentanaPrincipal] --> [Cola<T>]
[VentanaPrincipal] --> [Pila<T>]
[VentanaPrincipal] --> [VentanaColaEspera]
[VentanaPrincipal] --> [DialogoAgregarEstudiante]
[Cola<T>] --> [Nodo<T>]
[Pila<T>] --> [Nodo<T>]
[LibroDAO] --> [GestorConexionBD]
[AdministradorDAO] --> [GestorConexionBD]
[LibroDAO] ..> [Libro]
[LibroDAO] ..> [Prestamo]
[GestorConexionBD] --> DB : JDBC
@enduml
